{
  "name": "omniroute-lh",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "OmniRoute for LearnHarness: manage OmniRoute routing for LearnHarness's agents and view OmniRoute's data inside the app.",
  "scripts": {
    "sdk": "node scripts/sdk.mjs ../learnharness",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "install:local": "npm run build && node scripts/install-plugin-local.mjs",
    "inventory": "node scripts/build-endpoint-inventory.mjs ../OmniRoute --md docs/omniroute-endpoints.full.md",
    "release": "npm run check && node scripts/release.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "learnharness-plugin-api": "file:.sdk",
    "tsx": "4.23.12",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
